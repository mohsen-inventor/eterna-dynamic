{
  "name": "eternacloud-landing-page",
  "version": "1.0.0",
  "description": "EternaCloud landing page recreation with HTML5, Bootstrap 5, SCSS, and vanilla JavaScript",
  "main": "index.html",
  "scripts": {
    "build:css": "sass scss/styles.scss css/styles.min.css --style=compressed --no-source-map",
    "build:css:dev": "sass scss/styles.scss css/styles.css --style=expanded",
    "watch:css": "sass --watch scss/styles.scss:css/styles.min.css --style=compressed",
    "serve": "browser-sync start --server --port 3000 --files \"css/*.css, js/*.js, *.html, images/**/*\"",
    "build": "npm run build:css",
    "dev": "npm-run-all --parallel watch:css serve"
  },
  "keywords": [
    "eternacloud",
    "landing-page",
    "scss",
    "bootstrap",
    "html5"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.93.2"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
